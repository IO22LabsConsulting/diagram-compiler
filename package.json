{
  "name": "diagram-compiler",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Typed diagram spec in, checked SVG and PNG out. A Claude Code plugin.",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "schema": "node plugins/diagram-compiler/bin/diagram schema > schema/diagram-spec.v1.json"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.159",
    "@resvg/resvg-js": "2.6.2",
    "elkjs": "0.12.1",
    "opentype.js": "1.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.7",
    "@types/opentype.js": "1.3.10",
    "fast-check": "4.11.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "author": "IO22 LLC (https://io22labs.com/)",
  "homepage": "https://github.com/ayodm/diagram-compiler"
}
